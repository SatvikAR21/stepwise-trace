# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_ENV=development          # development | test | production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console           # console (pretty) | json (structured)

# --- LLM ---
# mock   = deterministic scripted responses, zero cost (default; used by tests and demo)
# openai = any OpenAI-compatible endpoint (OpenAI, Gemini, Groq, Ollama) via LLM_BASE_URL
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
# Groq:   https://api.groq.com/openai/v1
# Ollama: http://localhost:11434/v1
# OpenAI: leave empty
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Storage (relative paths resolve against the repo root) ---
TRACES_DIR=traces
DATABASE_PATH=backend/failure_forensics.db
