# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------- App
# development | test | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# console (pretty, for dev) | json (one object per line, for prod)
LOG_FORMAT=console

# ---------------------------------------------------------------- LLM
# mock   = deterministic scripted responses, zero cost (default; used by tests and demo)
# openai = any OpenAI-compatible endpoint (Gemini, Groq, Ollama, OpenAI) via LLM_BASE_URL
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash
# Gemini (free tier): https://generativelanguage.googleapis.com/v1beta/openai/
# Groq (free tier):   https://api.groq.com/openai/v1
# Ollama (local):     http://localhost:11434/v1
# OpenAI (paid):      leave empty
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# 0 = most deterministic
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=60
# retries with backoff on rate limits / transient errors (handled by the SDK)
LLM_MAX_RETRIES=3
# when an answer is not valid JSON of the right shape, show the model its problems and ask again (0-3)
LLM_MAX_REPAIR_ATTEMPTS=1
# client-side limit on requests per minute to the real provider (0 = off; Gemini free tier: 5)
LLM_MAX_RPM=0

# ---------------------------------------------------------------- Pipeline
# Intake keeps only the first N characters (a deliberate, realistic limit that can cause context loss)
INTAKE_MAX_CHARS=6000

# ---------------------------------------------------------------- Storage
# Relative paths resolve against the repo root.
DATA_DIR=backend/data
TRACES_DIR=traces
DATABASE_PATH=backend/stepwise.db
